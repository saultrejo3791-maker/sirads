<UserControl x:Class="SIRASD.Desktop.MedicationsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="MedicationTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="18,9"/><Setter Property="MinHeight" Value="38"/>
   <Style.Triggers><Trigger Property="Selector.IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Green}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Green}"/></Trigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="MedicationStatus">
   <Border CornerRadius="5" Padding="8,4" HorizontalAlignment="Left">
    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E3F1E9"/><Style.Triggers>
     <DataTrigger Binding="{Binding Status}" Value="Existencia baja"><Setter Property="Background" Value="#FFF1DD"/></DataTrigger>
     <DataTrigger Binding="{Binding Status}" Value="Sin existencias"><Setter Property="Background" Value="#FCE9E6"/></DataTrigger>
     <DataTrigger Binding="{Binding Status}" Value="Por caducar"><Setter Property="Background" Value="#FFF1DD"/></DataTrigger>
     <DataTrigger Binding="{Binding Status}" Value="Caducado"><Setter Property="Background" Value="#FCE9E6"/></DataTrigger>
    </Style.Triggers></Style></Border.Style>
    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#304D45"/>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <UniformGrid Columns="3" Margin="0,0,0,16">
   <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Lotes registrados" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="LotsText" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Existencia baja o agotada" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="LowStockText" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="#A17427" Margin="0,5,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="Caducidad por revisar" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="ExpiryText" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="#A65345" Margin="0,5,0,0" ToolTip="Lotes con existencias caducados o que caducan dentro de 30 días."/></StackPanel></Border>
  </UniformGrid>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Button x:Name="InventoryTab" Content="Inventario y suministro" Style="{StaticResource MedicationTab}" Click="InventoryTab_Click" Margin="0,0,9,0"/><Button x:Name="HistoryTab" Content="Bitácora de uso" Style="{StaticResource MedicationTab}" Click="HistoryTab_Click"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Gráficas y consumo" Click="Charts_Click" Padding="12,8" MinHeight="38" Margin="0,0,8,0"/><Button Content="Actualizar" Click="Refresh_Click" Padding="12,8" MinHeight="38"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid x:Name="InventoryPanel">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="InventorySearch" Margin="0,0,10,0" TextChanged="Filter_Changed" ToolTip="Buscar por medicamento, concentración o lote" AutomationProperties.Name="Buscar medicamento o lote"/>
     <ComboBox x:Name="StockFilter" Grid.Column="1" Margin="0,0,10,0" Padding="9" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Filtrar inventario">
      <ComboBoxItem Content="Todos los lotes"/><ComboBoxItem Content="Existencia baja"/><ComboBoxItem Content="Por caducar"/><ComboBoxItem Content="Caducados"/>
     </ComboBox>
     <Button Grid.Column="2" Content="+  Medicamento" Style="{StaticResource PrimaryButton}" Click="NewMedication_Click"/>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="1">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="Inventario por lote · busca y selecciona un medicamento" FontWeight="SemiBold" FontSize="13" Margin="16,13"/>
      <DataGrid Grid.Row="1" x:Name="InventoryGrid" ItemsSource="{Binding Medications}" SelectionChanged="Inventory_SelectionChanged" AutomationProperties.Name="Inventario de medicamentos" ScrollViewer.HorizontalScrollBarVisibility="Auto">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Medicamento" Binding="{Binding Name}" Width="*" MinWidth="140" ElementStyle="{StaticResource GridText}"/>
        <DataGridTextColumn Header="Concentración" Binding="{Binding Strength}" Width="115" ElementStyle="{StaticResource GridText}"/>
        <DataGridTextColumn Header="Presentación" Binding="{Binding Presentation}" Width="110" ElementStyle="{StaticResource GridText}"/>
        <DataGridTextColumn Header="Lote" Binding="{Binding Lot}" Width="95" ElementStyle="{StaticResource GridText}"/>
        <DataGridTextColumn Header="Caducidad" Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}" Width="112"/>
        <DataGridTextColumn Header="Existencia" Binding="{Binding StockDisplay}" Width="120" ElementStyle="{StaticResource GridText}"/>
        <DataGridTemplateColumn Header="Estado" CellTemplate="{StaticResource MedicationStatus}" Width="130" SortMemberPath="Status"/>
        <DataGridTextColumn Header="Mínimo" Binding="{Binding MinimumStock, StringFormat={}{0:0.###}}" Width="90"/>
        <DataGridTextColumn Header="Ubicación" Binding="{Binding Location}" Width="130" ElementStyle="{StaticResource GridText}"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="1" Text="No hay lotes para mostrar. Registra un medicamento o cambia la búsqueda." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="35,65,35,25" VerticalAlignment="Center" IsHitTestVisible="False">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Medications.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
    </Border>
    <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="SelectedMedicationText" Text="Selecciona un lote para registrar un movimiento." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>
     <WrapPanel><Button x:Name="ReceiveButton" Content="+  Registrar entrada" Click="Receive_Click" IsEnabled="False" Margin="0,0,9,4"/><Button x:Name="SupplyButton" Content="Suministrar a paciente" Click="Supply_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,9,4"/><Button x:Name="LossButton" Content="Registrar baja" Click="Loss_Click" IsEnabled="False" Margin="0,0,0,4"/></WrapPanel>
    </StackPanel>
   </Grid>
   <Grid x:Name="HistoryPanel" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
     <TextBox x:Name="HistorySearch" Margin="0,0,10,0" TextChanged="Filter_Changed" ToolTip="Buscar medicamento, lote, paciente, responsable o referencia" AutomationProperties.Name="Buscar en la bitácora"/>
     <ComboBox Grid.Column="1" x:Name="MovementFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" Padding="9" VerticalContentAlignment="Center" AutomationProperties.Name="Tipo de movimiento"><ComboBoxItem Content="Todos los movimientos"/><ComboBoxItem Content="Suministro"/><ComboBoxItem Content="Entrada"/><ComboBoxItem Content="Baja"/></ComboBox>
    </Grid>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,7,0"/><DatePicker x:Name="FromDate" Width="145" Margin="0,0,12,0" SelectedDateChanged="Filter_Changed" AutomationProperties.Name="Fecha inicial de la bitácora"/><TextBlock Text="Hasta" VerticalAlignment="Center" Margin="0,0,7,0"/><DatePicker x:Name="ToDate" Width="145" Margin="0,0,12,0" SelectedDateChanged="Filter_Changed" AutomationProperties.Name="Fecha final de la bitácora"/><Button Content="Limpiar filtros" Click="ClearFilters_Click" Padding="12,8" MinHeight="38"/></WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="1"><Grid>
     <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding Movements}" MouseDoubleClick="History_DoubleClick" AutomationProperties.Name="Bitácora de medicamentos" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Fecha y hora" Binding="{Binding OccurredAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
       <DataGridTextColumn Header="Movimiento" Binding="{Binding Type}" Width="125"/>
       <DataGridTextColumn Header="Medicamento" Binding="{Binding MedicationName}" Width="210" ElementStyle="{StaticResource GridText}"/>
       <DataGridTextColumn Header="Lote" Binding="{Binding Lot}" Width="100" ElementStyle="{StaticResource GridText}"/>
       <DataGridTextColumn Header="Cantidad" Binding="{Binding QuantityDisplay}" Width="120"/>
       <DataGridTextColumn Header="Paciente" Binding="{Binding PatientDisplay}" Width="220" ElementStyle="{StaticResource GridText}"/>
       <DataGridTextColumn Header="Responsable" Binding="{Binding Responsible}" Width="160" ElementStyle="{StaticResource GridText}"/>
       <DataGridTextColumn Header="Indicación / referencia" Binding="{Binding Reference}" Width="230" ElementStyle="{StaticResource GridText}"/>
       <DataGridTextColumn Header="Observaciones" Binding="{Binding Notes}" Width="210" ElementStyle="{StaticResource GridText}"/>
       <DataGridTextColumn Header="Registró" Binding="{Binding RecordedBy}" Width="160" ElementStyle="{StaticResource GridText}"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="No hay movimientos para los filtros seleccionados." Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="25" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Movements.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid></Border>
    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Movements.Count, StringFormat={}{0} movimientos · El historial conserva cada registro.}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Ver detalle" Click="Detail_Click" Padding="12,8"/></Grid>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="FeedbackText" Foreground="{StaticResource Green}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</UserControl>
