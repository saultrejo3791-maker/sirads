<Window x:Class="SIRASD.Desktop.MedicationMovementDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Movimiento de medicamento · SIRASD" Width="720" Height="820" MinWidth="620" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" Padding="28,22" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="MEDICAMENTOS / MOVIMIENTO" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="HeadingText" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock x:Name="MedicationText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="StockText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,20">
   <StackPanel x:Name="PatientFields"><TextBlock Text="Paciente que recibe el medicamento *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PatientBox" DisplayMemberPath="Label" SelectedValuePath="Id" Height="44" Margin="0,7,0,18" Padding="9" IsTextSearchEnabled="True" VerticalContentAlignment="Center" AutomationProperties.Name="Paciente del suministro"/></StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="QuantityLabel" Style="{StaticResource FieldLabel}"/><TextBox x:Name="QuantityBox" AutomationProperties.Name="Cantidad del movimiento"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Responsable del movimiento *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ResponsibleBox" MaxLength="150"/></StackPanel>
   </Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Fecha del movimiento *" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="DateBox"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Hora (24 horas, HH:mm) *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TimeBox" MaxLength="5"/></StackPanel>
   </Grid>
   <TextBlock Text="Cantidad en unidades de inventario. Usa punto decimal, sin separadores de miles." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,18"/>
   <TextBlock x:Name="ReferenceLabel" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReferenceBox" TextWrapping="Wrap" AcceptsReturn="True" Height="72" MaxLength="1500" VerticalScrollBarVisibility="Auto"/>
   <TextBlock x:Name="NotesLabel" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NotesBox" TextWrapping="Wrap" AcceptsReturn="True" Height="78" MaxLength="2000" VerticalScrollBarVisibility="Auto"/>
   <TextBlock x:Name="RecordedByText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" Background="White" Padding="28,16" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><StackPanel>
   <TextBlock x:Name="ValidationText" Foreground="#B42318" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="Registrar movimiento" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
  </StackPanel></Border>
 </Grid>
</Window>
