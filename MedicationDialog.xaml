<Window x:Class="SIRASD.Desktop.MedicationDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Registrar medicamento · SIRASD" Width="710" Height="800" MinWidth="610" MinHeight="630" WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" Padding="28,22" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="MEDICAMENTOS / NUEVO LOTE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Registrar medicamento" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,5"/><TextBlock Text="Copia el nombre, la concentración y la caducidad del envase." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,22">
   <TextBlock Text="Nombre del medicamento *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" MaxLength="150" AutomationProperties.Name="Nombre del medicamento"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Concentración del envase *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StrengthBox" MaxLength="100" ToolTip="Copia la concentración tal como aparece en el envase."/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Presentación *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PresentationBox" MaxLength="100" ToolTip="Por ejemplo: tabletas, solución o ampolletas."/></StackPanel>
   </Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Unidad para contar existencias *" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UnitBox" Height="43" Padding="9" Margin="0,7,0,18" VerticalContentAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Lote *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LotBox" MaxLength="100"/></StackPanel>
   </Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Caducidad *" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="ExpiryPicker"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Ubicación en el centro" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LocationBox" MaxLength="150"/></StackPanel>
   </Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Existencia inicial *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OpeningBox" Text="0"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Existencia mínima *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MinimumBox" Text="0"/></StackPanel>
   </Grid>
   <TextBlock Text="Cantidades en la unidad elegida. Hasta 3 decimales con punto, sin separadores de miles." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,-5,0,17"/>
   <TextBlock Text="Origen / referencia de la existencia inicial" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReferenceBox" MaxLength="500" ToolTip="Obligatorio si registras una existencia inicial mayor que cero."/>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" Background="White" Padding="28,16" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><StackPanel>
   <TextBlock x:Name="ValidationText" Foreground="#B42318" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="Guardar medicamento" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
  </StackPanel></Border>
 </Grid>
</Window>
